# Botify Dashboard - Environment Variables

## Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=admin
DB_NAME=botify_db

## Server Configuration
API_PORT=3000
BASE_URL=http://localhost
HOST_URL=http://localhost:3000

## MQTT Configuration
MQTT_PORT=1883

## Telegram Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here

## Node Environment
NODE_ENV=development

## Logger Configuration
# Set the environment explicitly (development, production, staging)
NODE_ENV=development

# Set log level (debug, info, warn, error)
# Debug   = Show all logs including debug messages (default in development)
# Info    = Hide debug logs, show info/warn/error (default in production)
# Warn    = Show only warn/error logs
# Error   = Show only error logs
BOTIFY_LOG_LEVEL=debug

# Examples:
# NODE_ENV=production         → Auto sets log level to 'info' (debug logs hidden)
# NODE_ENV=development        → Auto sets log level to 'debug' (all logs shown)
# BOTIFY_LOG_LEVEL=debug      → Override: show all logs
# BOTIFY_LOG_LEVEL=info       → Override: hide debug logs
# BOTIFY_LOG_LEVEL=error      → Override: show only errors

## Summary
# Production Environment:
#   - NODE_ENV=production
#   - Debug logs automatically hidden
#   - Only error, warning, info, success logs shown
#
# Development Environment:
#   - NODE_ENV=development
#   - Debug logs shown by default
#   - All log levels visible
#
# Custom Override:
#   - Use BOTIFY_LOG_LEVEL to override default behavior
#   - Useful for debugging in production (BOTIFY_LOG_LEVEL=debug)
#   - Or reducing noise in development (BOTIFY_LOG_LEVEL=warn)
